kc() { security find-generic-password -a "$USER" -s "$1" -w; }

export AWS_ACCESS_KEY_ID="$(kc homelab-r2-access-key-id)"
export AWS_SECRET_ACCESS_KEY="$(kc homelab-r2-secret-access-key)"
export AWS_ENDPOINT_URL_S3="$(kc homelab-r2-endpoint)"
export TF_VAR_state_passphrase="$(kc homelab-tofu-state-passphrase)"
export PROXMOX_VE_API_TOKEN="$(kc homelab-proxmox-api-token)"
