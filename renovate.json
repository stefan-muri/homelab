{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Vienna",
  "schedule": ["before 7am on monday"],
  "automergeSchedule": ["after 6pm and before 10pm on monday"],
  "platformAutomerge": false,
  "pinDigests": true,
  "labels": ["updates"],
  "prConcurrentLimit": 10,
  "kubernetes": {
    "managerFilePatterns": ["/^kubernetes/.+\\.ya?ml$/"]
  },
  "argocd": {
    "managerFilePatterns": ["/^kubernetes/apps/.+\\.ya?ml$/"]
  },
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible/roles/k3s/defaults/main\\.yaml$/"],
      "matchStrings": ["k3s_version: (?<currentValue>v\\S+)"],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible/roles/k3s/defaults/main\\.yaml$/"],
      "matchStrings": ["kube_vip_version: (?<currentValue>v\\S+)"],
      "depNameTemplate": "ghcr.io/kube-vip/kube-vip",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^kubernetes/.+\\.ya?ml$/"],
      "matchStrings": ["imageName: (?<depName>ghcr\\.io/cloudnative-pg/postgresql):(?<currentValue>\\S+)"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s+\\w+: (?<currentValue>\\S+)"]
    }
  ],
  "packageRules": [
    {
      "description": "Applications: minor, patch and digest updates are merged once CI passes.",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchPackageNames": ["!ghcr.io/kobsermusic/kobser"],
      "groupName": "routine updates",
      "automerge": true
    },
    {
      "description": "Platform components are reviewed by hand: Helm charts, OpenTofu providers, k3s, kube-vip, PostgreSQL and the GPU plugin.",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchDatasources": ["helm"],
      "groupName": "platform updates",
      "automerge": false
    },
    {
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchManagers": ["terraform"],
      "groupName": "platform updates",
      "automerge": false
    },
    {
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchPackageNames": ["k3s-io/k3s", "ghcr.io/kube-vip/kube-vip", "ghcr.io/cloudnative-pg/postgresql", "intel/intel-device-plugins-for-kubernetes"],
      "groupName": "platform updates",
      "automerge": false
    },
    {
      "description": "A PostgreSQL major upgrade takes every database cluster offline and needs its own plan.",
      "matchPackageNames": ["ghcr.io/cloudnative-pg/postgresql"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Regex managers have no digest to pin.",
      "matchManagers": ["custom.regex"],
      "pinDigests": false
    },
    {
      "matchPackageNames": ["/^lscr\\.io/linuxserver//"],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?(?:_v[\\d.]+)?(?<compatibility>(?:ubu\\d+)?)(?:-r\\d+)?-ls(?<revision>\\d+)$"
    },
    {
      "description": "pure-ftpd tags carry the Debian release: trixie-1.0.50.",
      "matchPackageNames": ["stilliard/pure-ftpd"],
      "versioning": "regex:^trixie-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "Nextcloud refuses to skip a major.",
      "matchPackageNames": ["nextcloud"],
      "matchUpdateTypes": ["major"],
      "prBodyNotes": ["Nextcloud upgrades one major at a time. If this skips a major, deploy the one in between first. Check that a backup from the same night exists before merging."]
    },
    {
      "description": "kobser is built from its own repository. Its newest build goes live without review.",
      "matchPackageNames": ["ghcr.io/kobsermusic/kobser"],
      "schedule": ["at any time"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "description": "k3s supports upgrading one minor version at a time. Apply with ansible-playbook playbooks/k3s.yaml.",
      "matchPackageNames": ["k3s-io/k3s"],
      "matchUpdateTypes": ["minor", "major"],
      "groupName": null,
      "prBodyNotes": ["k3s: upgrade one minor version at a time, then run playbooks/k3s.yaml."]
    }
  ]
}
